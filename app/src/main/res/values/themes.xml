<resources>
    <!-- Base Application Theme -->
    <style name="Theme.CalendarEventAlarm" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/bg_main</item>
    </style>

    <!-- Fullscreen Alarm Screen Theme -->
    <style name="Theme.CalendarEventAlarm.AlarmOverlay" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/alarm_bg_dark</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:keepScreenOn">true</item>
    </style>
</resources>
